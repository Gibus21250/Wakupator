#!/bin/sh /etc/rc.common

USE_PROCD=1

START=95
STOP=10

PROG="/usr/sbin/wakupator"

start_instance() {
    local cfg="$1"
    local enabled interface host port
    local st spd wma wd wkc

    config_get_bool enabled "$cfg" 'enabled' 0
    [ "$enabled" -eq 1 ] || return 0

    config_get interface "$cfg" interface
    config_get host "$cfg" host "0.0.0.0"
    config_get port "$cfg" port "13717"
    config_get st "$cfg" shutdown_timeout "600"
    config_get spd "$cfg" shutdown_probe_delay "4"
    config_get wma "$cfg" wol_max_attempts "3"
    config_get wd "$cfg" wol_delay "30"
    config_get wkc "$cfg" wol_keep_client "1"

    [ -n "$interface" ] || {
        echo "wakupator[$cfg]: interface name required."
        return 1
    }

    procd_open_instance "$cfg"

    procd_set_param command "$PROG" \
        -if "$interface" \
        -H "$host" \
        -p "$port" \
        -st "$st" \
        -spd "$spd" \
        -wma "$wma" \
        -wd "$wd" \
        -wkc "$wkc"

    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1

    procd_close_instance
}

start() {
    config_load wakupator
    config_foreach start_instance wakupator
}

start_service() {
    config_load wakupator
    config_foreach start_instance wakupator
}

service_triggers() {
    procd_add_reload_trigger wakupator
}
